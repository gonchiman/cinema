<style>
  table {
      border-collapse: collapse;
  }

  th, td {
      border: 1px solid black;
      padding: 8px 12px;
  }

  th {
    text-align: center;
  }

  td {
    text-align: left;
  }
</style>

<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<div id="movies">
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Description</th>
        <th>Release date</th>
        <th>Average points</th>
        <th>Show</th>
        <th>Edit</th>
        <th>New Review</th>
      </tr>
    </thead>

    <tbody>
      <% @movies.each do |movie| %>
        <tr>
          <td><%= movie.title %></td>
          <td><%= movie.description %></td>
          <td><%= movie.release_date %></td>
          <td>
            <% average = movie.reviews.average(:points) %>
            <%= average.present? ? average.round(1) : "No reviews" %>
          </td>
          <td><%= link_to "Show", movie %></td>
          <td><%= link_to "Edit", edit_movie_path(movie) %></td>
          <td><%= link_to "New Review", new_review_path(movie_id: movie.id) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= link_to "New movie", new_movie_path %>
