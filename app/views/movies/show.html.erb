<style>
  table {
      border-collapse: collapse;
  }

  th, td {
      border: 1px solid black;
      padding: 8px 12px;
  }

  th {
    text-align: center;
  }

  td {
    text-align: left;
  }
</style>

<p style="color: green"><%= notice %></p>

<%= render @movie %>

<table>
  <thead>
    <tr>
      <th>Content</th>
      <th>Link</th>
    </tr>
  </thead>

  <tbody>
    <% @movie.reviews.each do |review| %>
      <tr>
        <td><%= review.content %></td>
        <td><%= link_to "Show this review", review %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div>
  <%= link_to "Edit this movie", edit_movie_path(@movie) %> |
  <%= link_to "Back to movies", movies_path %> |
  <%= link_to "Create Review", new_review_path %>

  <%= button_to "Destroy this movie", @movie, method: :delete %>
</div>
