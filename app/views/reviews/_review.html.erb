<div id="<%= dom_id review %>">
  <div>
    <strong>Content:</strong>
    <%= review.content %>
  </div>

  <div>
    <strong>Movie Id:</strong>
    <%= review.movie_id %>
  </div>

  <div>
    <strong>Movie Title:</strong>
    <%= review.movie.title %>
